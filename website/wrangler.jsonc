{
  "name": "kimlulu-note",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "note.kimlulu.com", "custom_domain": true },
    { "pattern": "https://kimlulu.com/*", "zone_name": "kimlulu.com" },
    { "pattern": "https://www.kimlulu.com/*", "zone_name": "kimlulu.com" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
