<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NewtonsoftPath Condition="'$(KimNotesDependencyDirectory)' == ''">..\..\packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</NewtonsoftPath>
    <NewtonsoftPath Condition="'$(KimNotesDependencyDirectory)' != ''">$(KimNotesDependencyDirectory)\Newtonsoft.Json.dll</NewtonsoftPath>
    <LiteNetLibPath Condition="'$(KimNotesDependencyDirectory)' == ''">..\..\packages\LiteNetLib.1.3.5\lib\netstandard2.0\LiteNetLib.dll</LiteNetLibPath>
    <LiteNetLibPath Condition="'$(KimNotesDependencyDirectory)' != ''">$(KimNotesDependencyDirectory)\LiteNetLib.dll</LiteNetLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="netstandard" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
    <Reference Include="LiteNetLib"><HintPath>$(LiteNetLibPath)</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Properties\AssemblyInfo.cs" />
    <Compile Include="..\..\utils\CloudApi.cs;..\..\utils\CloudStore.cs;..\..\utils\CloudDocuments.cs;..\..\utils\CloudSync.cs;..\..\utils\SyncSchedule.cs" />
    <Compile Include="..\..\utils\DesktopEndpoints.cs;..\..\utils\DesktopSession.cs;..\..\utils\InitConfig.cs;..\..\utils\Storage.cs;..\..\utils\ServiceCredentials.cs" />
    <Compile Include="..\..\utils\NoteTheme.cs;..\..\utils\NoteIndex.cs;..\..\utils\NoteImages.cs;..\..\utils\TodoStore.cs;..\..\utils\Translator.cs;..\..\utils\ScreenshotArchive.cs;..\..\utils\UpdateNotice.cs" />
    <Compile Include="..\..\main\EncryptedFileTransfer.cs;..\..\main\FileTransferProtocol.cs;..\..\main\FileTransferBundle.cs;..\..\main\FileTransferLan.cs" />
    <Compile Include="..\..\main\FileTransferP2p.cs;..\..\main\FileTransferPickup.cs;..\..\main\FileTransferAccount.cs;..\..\main\FileTransferInvite.cs;..\..\main\FileTransferReception.cs" />
    <EmbeddedResource Include="..\..\Resources\remind.wav"><LogicalName>KimNotes.remind.wav</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="$(KimNotesBaiduCredentialsFile)"
                      Condition="Exists('$(KimNotesBaiduCredentialsFile)')">
      <LogicalName>KimNotes.baidu-credentials.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(KimNotesEndpointsFile)"
                      Condition="Exists('$(KimNotesEndpointsFile)')">
      <LogicalName>KimNotes.desktop-endpoints.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="CheckDesktopEndpoints" BeforeTargets="BeforeBuild"
          Condition="'$(RequireDesktopEndpoints)' == 'true' and !Exists('$(KimNotesEndpointsFile)')">
    <Error Text="The desktop release requires desktop-endpoints.local.json." />
  </Target>
</Project>
